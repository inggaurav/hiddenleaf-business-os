{
    "name": "hiddenleaf/business-os",
    "type": "project",
    "description": "HiddenLeaf BusinessOS — Enterprise Multi-Tenant SaaS Platform",
    "keywords": ["hiddenleaf", "business-os", "saas", "laravel", "inertia", "react"],
    "license": "proprietary",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "HiddenLeaf\\": "app/",
            "HiddenLeaf\\Kernel\\": "packages/hiddenleaf/kernel/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
